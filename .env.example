# 复制为 .env.local 并填入真实配置；双站构建另见 .env.zh / .env.en
#
# === 公开（可写入前端 bundle）===
# Supabase 项目 URL
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anon/Public Key（客户端可见）
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 高德地图 JS API Key（浏览器侧调用必须公开）
VITE_AMAP_API_KEY=your_amap_api_key
VITE_AMAP_SECURITY_CODE=your_amap_security_code

# Google Maps JS API（如保留）
VITE_GOOGLE_MAP_API_KEY=your_google_map_api_key

# === 已迁移到 Supabase Edge Functions（不要再放到前端）===
# Gemini API Key 现在以 GEMINI_API_KEY 形式存放在 Supabase Functions 的 Secrets 中，
# 由 supabase/functions/gemini-proxy 调用 Google REST API。
# 浏览器只通过 supabase.functions.invoke('gemini-proxy', { body: ... }) 调用。
# VITE_GEMINI_API_KEY=__已废弃__
